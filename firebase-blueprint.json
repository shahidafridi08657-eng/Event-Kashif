{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for players and admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "player"] },
        "accountStatus": { "type": "string", "enum": ["active", "restricted", "banned"] },
        "payoutPreference": { "type": "string", "enum": ["upi", "redemption_code"] },
        "upiId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Public tournament details and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "gameMode": { "type": "string", "enum": ["BR", "CS", "LONE_WOLF"] },
        "matchFormat": { "type": "string" },
        "entryFeePaise": { "type": "integer" },
        "maxParticipants": { "type": "integer" },
        "expectedParticipants": { "type": "integer" },
        "registeredCount": { "type": "integer" },
        "verifiedCount": { "type": "integer" },
        "firstPrizePaise": { "type": "integer" },
        "secondPrizePaise": { "type": "integer" },
        "thirdPrizePaise": { "type": "integer" },
        "totalPrizeCommitmentPaise": { "type": "integer" },
        "startAt": { "type": "string" },
        "registrationDeadline": { "type": "string" },
        "status": { "type": "string", "enum": ["UPCOMING", "ONGOING", "COMPLETED", "CANCELLED"] },
        "isDemo": { "type": "boolean" },
        "rules": { "type": "string" },
        "bannerGradientIndex": { "type": "integer" },
        "championTeamName": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "gameMode", "entryFeePaise", "status"]
    },
    "TournamentPrivate": {
      "title": "TournamentPrivate",
      "description": "Secret room credentials released only to confirmed players and admin",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "roomId": { "type": "string" },
        "roomPassword": { "type": "string" },
        "releaseTime": { "type": "string" },
        "instructions": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tournamentId"]
    },
    "Registration": {
      "title": "Registration",
      "description": "Tournament registration request by player",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tournamentId": { "type": "string" },
        "playerUid": { "type": "string" },
        "playerName": { "type": "string" },
        "playerEmail": { "type": "string" },
        "teamName": { "type": "string" },
        "gameId": { "type": "string" },
        "registrationStatus": { "type": "string", "enum": ["PENDING", "CONFIRMED", "REJECTED", "CANCELLED"] },
        "paymentStatus": { "type": "string", "enum": ["PENDING_CLAIM", "UNDER_REVIEW", "VERIFIED", "REJECTED"] },
        "transactionReference": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tournamentId", "playerUid", "registrationStatus"]
    },
    "PaymentClaim": {
      "title": "PaymentClaim",
      "description": "Submitted payment claim for admin verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "registrationId": { "type": "string" },
        "tournamentId": { "type": "string" },
        "tournamentTitle": { "type": "string" },
        "playerUid": { "type": "string" },
        "playerName": { "type": "string" },
        "playerEmail": { "type": "string" },
        "claimedAmountPaise": { "type": "integer" },
        "transactionReference": { "type": "string" },
        "status": { "type": "string", "enum": ["SUBMITTED", "APPROVED", "REJECTED"] },
        "rejectionReason": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string" }
      },
      "required": ["id", "registrationId", "tournamentId", "playerUid", "claimedAmountPaise", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "In-app message between player and admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "recipientUid": { "type": "string" },
        "tournamentId": { "type": "string" },
        "content": { "type": "string" },
        "isRedemptionCode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderUid", "recipientUid", "content"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Admin payment and contact configuration",
      "type": "object",
      "properties": {
        "upiId": { "type": "string" },
        "accountHolderName": { "type": "string" },
        "paymentInstructions": { "type": "string" },
        "qrImageUrl": { "type": "string" },
        "ownerEmail": { "type": "string" }
      },
      "required": ["upiId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile records"
    },
    "/tournaments/{tournamentId}": {
      "schema": { "$ref": "#/entities/Tournament" },
      "description": "Public tournament records"
    },
    "/tournamentPrivate/{tournamentId}": {
      "schema": { "$ref": "#/entities/TournamentPrivate" },
      "description": "Private room credentials for tournaments"
    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Tournament player registrations"
    },
    "/paymentClaims/{claimId}": {
      "schema": { "$ref": "#/entities/PaymentClaim" },
      "description": "Payment verification claims for admin review"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Chat messages between player and admin"
    },
    "/adminSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AdminSettings" },
      "description": "Admin payment configuration"
    }
  }
}
