rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'shahidafridi08657@gmail.com' ||
        request.auth.token.email == 'kashif@eventkashif.com'
      );
    }

    function isAdmin() {
      return isOwnerEmail() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Tournaments (Public)
    match /tournaments/{tournamentId} {
      allow read: true;
      allow create, update, delete: if isAdmin();
    }

    // Tournament Private (Room ID & Password)
    match /tournamentPrivate/{tournamentId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/registrations/$(tournamentId + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/registrations/$(tournamentId + '_' + request.auth.uid)).data.registrationStatus == 'CONFIRMED'
      );
      allow write: if isAdmin();
    }

    // Registrations
    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (
        resource.data.playerUid == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.playerUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Payment Claims
    match /paymentClaims/{claimId} {
      allow read: if isAuthenticated() && (
        resource.data.playerUid == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.playerUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admin Settings
    match /adminSettings/{settingId} {
      allow read: true;
      allow write: if isAdmin();
    }

    // Financial Ledger & Audit Logs
    match /financialLedger/{ledgerId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
